<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- This container will hold your fragments -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Your Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-1dp"
        android:background="@color/menu_background"
        app:menu="@menu/menu_bottom_nav"
        app:itemBackground="@drawable/bottom_nav_hover_background"
        app:itemIconTint="@color/primary_brown"
        app:itemTextColor="@color/primary_brown"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
        app:itemActiveIndicatorStyle="@style/BottomNav_NoIndicator"/>

</RelativeLayout>
