<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText android:id="@+id/etOwnerName"  android:hint="ФИО"             android:layout_width="match_parent" android:layout_height="48dp"/>
        <EditText android:id="@+id/etOwnerEmail" android:hint="Адрес почты"     android:inputType="textEmailAddress"
            android:layout_width="match_parent" android:layout_height="48dp"/>
        <EditText android:id="@+id/etOwnerPhone" android:hint="Номер телефона"  android:inputType="phone"
            android:layout_width="match_parent" android:layout_height="48dp"/>
    </LinearLayout>
</ScrollView>
