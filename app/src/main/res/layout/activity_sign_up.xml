<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED"
    tools:context=".SignUpActivity">

    <View
        android:id="@+id/background_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary_brown"
        app:layout_constraintBottom_toTopOf="@+id/guideline_card_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.45" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_card_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4" />

    <androidx.cardview.widget.CardView
        android:id="@+id/icon_card"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardBackgroundColor="@color/secondary_pink"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/signup_card_container"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_gravity="center"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.435">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/my_logo"
            app:tint="@color/primary_brown"
            tools:ignore="MissingConstraints" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/signup_card_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_card_start"
        app:layout_constraintVertical_bias="0.0">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:clipToPadding="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tv_login_tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Войти"
                    android:textColor="@color/text_hint"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_register_tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="76dp"
                    android:layout_marginTop="12dp"
                    android:text="Регистрация"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/tv_login_tab"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/tab_indicator_line"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:background="@color/primary_brown"
                    app:layout_constraintEnd_toEndOf="@+id/tv_register_tab"
                    app:layout_constraintStart_toStartOf="@+id/tv_register_tab"
                    app:layout_constraintTop_toBottomOf="@+id/tv_register_tab" />

                <TextView
                    android:id="@+id/tv_pet_data_title"
                    style="@style/SectionTitleStyle"
                    android:layout_marginTop="24dp"
                    android:text="Данные о питомце"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tab_indicator_line" />

                <EditText
                    android:id="@+id/et_pet_name"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Имя питомца"
                    android:inputType="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_pet_data_title" />

                <Spinner
                    android:id="@+id/spinner_pet_type"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:entries="@array/pet_types"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_pet_name" />

                <EditText
                    android:id="@+id/et_breed"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Порода"
                    android:inputType="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/spinner_pet_type" />

                <EditText
                    android:id="@+id/et_dob"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Дата рождения"
                    android:inputType="date"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_breed" />

                <TextView
                    android:id="@+id/tv_owner_data_title"
                    style="@style/SectionTitleStyle"
                    android:layout_marginTop="24dp"
                    android:text="Данные о владельце"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_dob" />

                <EditText
                    android:id="@+id/et_owner_name"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Имя владельца"
                    android:inputType="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_owner_data_title" />

                <EditText
                    android:id="@+id/et_phone_number"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Номер телефона"
                    android:inputType="phone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_owner_name" />

                <EditText
                    android:id="@+id/et_email_address"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Адрес почты"
                    android:inputType="textEmailAddress"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_phone_number" />

                <TextView
                    android:id="@+id/tv_login_credentials_title"
                    style="@style/SectionTitleStyle"
                    android:layout_marginTop="24dp"
                    android:text="Учетные данные для входа"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_email_address" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Пароль"
                    android:inputType="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_login_credentials_title" />

                <EditText
                    android:id="@+id/et_confirm_password"
                    style="@style/RegistrationInputStyle"
                    android:layout_marginTop="8dp"
                    android:hint="Повторите пароль"
                    android:inputType="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_password" />

                <CheckBox
                    android:id="@+id/cb_agree_terms"
                    style="@style/GreenCheckboxStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Я принимаю правила и соглашение об использовании"
                    android:textColor="@color/text_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_confirm_password" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_register"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:text="Зарегистрироваться"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:backgroundTint="@color/login_button_green"
                    app:cornerRadius="28dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cb_agree_terms" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>